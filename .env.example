# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 git에 올라가지 않습니다.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
KAKAO_REST_API_KEY=
# Client Secret을 사용 설정한 경우에만 입력 (아니면 비워 둠)
KAKAO_CLIENT_SECRET=
# 아래 두 개는 scripts/kakao_auth.py 가 알려 주는 값을 입력
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
# GitHub Pages 주소 (예: https://내아이디.github.io/저장소이름)
PAGES_BASE_URL=
